{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "target": "ES2019",
    "jsx": "react",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["../server/src/*"]
    }
  }
}
